# Copie para .env.local e preencha com os valores do ambiente.
# Os valores do ambiente local são impressos por `npm run db:start`.
# Nenhum segredo real entra neste arquivo — ele é versionado.

# ---------------------------------------------------------------------------
# Cliente (expostas ao navegador)
# ---------------------------------------------------------------------------

# URL da API do projeto Supabase. Local: http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# Chave pública anônima. Sujeita à RLS — pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# Origem usada para montar o redirect do link mágico. Sem barra no final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Servidor (nunca expostas ao navegador)
# ---------------------------------------------------------------------------

# Chave service-role: ignora a RLS. Lida apenas por src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# String de conexão usada por migrations e seed — não pela aplicação.
# Local: postgresql://postgres:postgres@127.0.0.1:54422/postgres
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# ---------------------------------------------------------------------------
# Meta
# ---------------------------------------------------------------------------

# local | staging | production — o seed se recusa a rodar com production.
APP_ENV=local

# ---------------------------------------------------------------------------
# Pagamentos (só lidas por src/lib/payments/*.ts e pelas rotas de
# checkout/webhook — nunca pelo resto da aplicação, ver design.md do change
# add-gifts-payments-backend)
# ---------------------------------------------------------------------------

# Segredo usado para validar a assinatura HMAC do webhook de pagamento.
# Credencial de teste em local/staging, real só em produção.
PAYMENT_WEBHOOK_SECRET=cole-o-segredo-de-webhook-aqui

# Chaves do provedor de pagamento. Não lidas pelo provedor mock local — só
# entram em uso quando um provedor real for integrado.
PAYMENT_PROVIDER_SECRET_KEY=cole-a-chave-secreta-do-provedor-aqui
PAYMENT_PROVIDER_PUBLIC_KEY=cole-a-chave-publica-do-provedor-aqui
